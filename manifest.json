{
    "manifest_version": 3,
    "name": "bot4shuffle",
    "description": "a javascript casino bot",
    "version": "1.1.0.0",
    "icons": {
        "128": "shuffle.png"
    },
    "options_page": "",
    "action": {
        "default_title": "bot4shuffle"
    },
     "permissions": ["webNavigation", "scripting", "tabs", "activeTab"],
  "host_permissions": ["https://shuffle.game/*", "https://shuffle.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "bot4shuffle"
  },
	"web_accessible_resources": [
	{
	  "resources": [
      "index.js",
      "inject.js",
      "js/*.js"
    ],
	  "matches": [ "https://*/*" ]
	}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self';"
  }
}